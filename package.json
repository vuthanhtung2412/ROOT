{
  "name": "root",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @root/web dev",
    "dev:phaser": "pnpm --filter @root/phaser dev",
    "build:web": "pnpm --filter @root/web build",
    "build:lib": "pnpm --filter @root/lib build",
    "build:phaser": "pnpm --filter @root/phaser build",
    "serve:game": "pnpm --filter @root/web serve:phaser",
    "gen:api-client": "pnpm --filter @root/web-client gen",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint lib/src lib/scripts backend/web/src backend/web/scripts"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "allowBuilds": {
      "esbuild": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
