# Copy to `.env` and fill in. Mise loads `.env` via `.mise.toml` `[env] _.file = ".env"`.
ROOT_DEV_API=
ROOT_PROD_API=
# Backend extra CORS origins (comma list), e.g. https://<owner>.github.io
ROOT_CORS_ORIGINS=
# `1` turns on the birthday edition theme (menu, lobby, Lizard Cult art).
ROOT_BIRTHDAY_EDITION=
# Tailscale Funnel HTTPS port for `pnpm remote` (443, 8443 or 10000). Default 443.
FUNNEL_HTTPS_PORT=
