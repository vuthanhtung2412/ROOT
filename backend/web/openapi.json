{
  "openapi": "3.0.0",
  "info": {
    "title": "@root/web",
    "version": "0.0.1",
    "description": "Single-slot Root GP2 HTTP API (Marquise vs Eyrie)"
  },
  "components": {
    "schemas": {
      "ServiceInfo": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "lib": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ]
          }
        },
        "required": [
          "service",
          "lib"
        ]
      },
      "CreateGameResponse": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/GameState"
          },
          "mode": {
            "$ref": "#/components/schemas/LobbyMode"
          }
        },
        "required": [
          "state",
          "mode"
        ]
      },
      "GameState": {
        "type": "object",
        "additionalProperties": {
          "nullable": true
        }
      },
      "LobbyMode": {
        "type": "string",
        "enum": [
          "hotseat",
          "online"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "nullable": true
          }
        },
        "required": [
          "code"
        ]
      },
      "CreateGameBody": {
        "type": "object",
        "properties": {
          "factions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FactionId"
            }
          },
          "mode": {
            "$ref": "#/components/schemas/LobbyMode"
          }
        }
      },
      "FactionId": {
        "type": "string",
        "enum": [
          "marquise",
          "eyrie",
          "alliance",
          "vagabond",
          "lizard",
          "riverfolk"
        ]
      },
      "ActionResult": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/GameState"
          },
          "log": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogEntry"
            }
          }
        },
        "required": [
          "state",
          "log"
        ]
      },
      "LogEntry": {
        "type": "object",
        "additionalProperties": {
          "nullable": true
        }
      },
      "JoinBody": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "playerId"
        ]
      },
      "GetGameResponse": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/GameState"
          },
          "historyLength": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "$ref": "#/components/schemas/LobbyMode"
          }
        },
        "required": [
          "state",
          "historyLength",
          "mode"
        ]
      },
      "GameSnapshot": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/GameState"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "log": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogEntry"
            }
          },
          "rng": {
            "type": "object",
            "properties": {
              "seed": {
                "type": "number"
              },
              "cursor": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "seed",
              "cursor"
            ]
          }
        },
        "required": [
          "state",
          "history",
          "log",
          "rng"
        ]
      },
      "Action": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": {
          "nullable": true
        }
      },
      "LegalActionsResponse": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionSpec"
            }
          }
        },
        "required": [
          "actions"
        ]
      },
      "ActionSpec": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "actor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "nullable": true
              }
            }
          }
        },
        "required": [
          "type",
          "actor"
        ]
      },
      "LogResponse": {
        "type": "object",
        "properties": {
          "log": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogEntry"
            }
          }
        },
        "required": [
          "log"
        ]
      },
      "UndoResponse": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/GameState"
          }
        },
        "required": [
          "state"
        ]
      },
      "FallMapResponse": {
        "type": "object",
        "properties": {
          "clearings": {
            "type": "array",
            "items": {
              "nullable": true
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "rivers": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "forests": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "corners": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "vagabondForest": {
            "type": "integer"
          }
        },
        "required": [
          "clearings",
          "paths",
          "rivers",
          "forests",
          "corners",
          "vagabondForest"
        ]
      },
      "FallLayoutResponse": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "clearings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "r": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "r"
              ]
            }
          }
        },
        "required": [
          "image",
          "clearings"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Service info",
        "responses": {
          "200": {
            "description": "Service metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            }
          }
        }
      }
    },
    "/game": {
      "post": {
        "tags": [
          "game"
        ],
        "summary": "Create lobby",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ],
              "description": "Set to 1 to replace an existing game in the single slot"
            },
            "required": false,
            "description": "Set to 1 to replace an existing game in the single slot",
            "name": "replace",
            "in": "query"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGameBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lobby created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateGameResponse"
                }
              }
            }
          },
          "400": {
            "description": "Rule or request error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No game in slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Game already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "game"
        ],
        "summary": "Get current game",
        "responses": {
          "200": {
            "description": "Current game",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetGameResponse"
                }
              }
            }
          },
          "400": {
            "description": "Rule or request error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No game in slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Game already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "game"
        ],
        "summary": "Clear game slot",
        "responses": {
          "204": {
            "description": "Cleared"
          }
        }
      }
    },
    "/game/join": {
      "post": {
        "tags": [
          "game"
        ],
        "summary": "Join lobby",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinBody"
              }
            }
          }
        },
        "responses": {
