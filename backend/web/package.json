{
  "name": "@root/web",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:openapi": "tsx scripts/export-openapi.ts",
    "serve:react": "tsx scripts/serve-react.ts",
    "serve:phaser": "echo 'deprecated: use serve:react' >&2 && tsx scripts/serve-react.ts",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@root/lib": "workspace:*",
    "hono": "^4.13.8",
    "openai": "^7.32.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
